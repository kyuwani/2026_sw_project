generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum LearningCategory {
  LANGUAGE
  FRAMEWORK
  ALGORITHM
  DATABASE
  DEVOPS
  OTHER
}

enum GitHubRepositoryVisibility {
  PRIVATE
  PUBLIC
}

enum GitHubRepositoryPermission {
  ADMIN
  WRITE
  READ
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String?
  email               String?            @unique
  emailVerified       DateTime?
  image               String?
  bio                 String?            @db.Text
  githubUrl           String?
  passwordHash        String?
  timezone            String             @default("Asia/Seoul")
  accounts            Account[]
  sessions            Session[]
  projects            Project[]
  learningLogs        LearningLog[]
  githubRepositories  GitHubRepository[]
  primaryTechnologies UserTechnology[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id            String              @id @default(uuid()) @db.Uuid
  title         String
  description   String?             @db.Text
  status        ProjectStatus       @default(PLANNING)
  startDate     DateTime?           @db.Date
  endDate       DateTime?           @db.Date
  repositoryUrl String?
  repositoryId  String?             @db.Uuid
  userId        String              @db.Uuid
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository    GitHubRepository?   @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  tasks         Task[]
  technologies  ProjectTechnology[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([repositoryId])
}

model GitHubRepository {
  id              String                     @id @default(uuid()) @db.Uuid
  externalId      String
  name            String
  fullName        String
  ownerLogin      String
  ownerAvatarUrl  String?
  htmlUrl         String
  description     String?                    @db.Text
  visibility      GitHubRepositoryVisibility
  permission      GitHubRepositoryPermission
  language        String?
  defaultBranch   String
  isFork          Boolean
  isArchived      Boolean
  remoteUpdatedAt DateTime
  remotePushedAt  DateTime?
  cachedAt        DateTime                   @default(now())
  userId          String                     @db.Uuid
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects        Project[]

  @@unique([userId, externalId])
  @@index([userId, remoteUpdatedAt])
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @db.Date
  completedAt DateTime?
  projectId   String       @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId, status])
  @@index([projectId, dueDate])
}

model LearningLog {
  id           String                  @id @default(uuid()) @db.Uuid
  title        String
  content      String                  @db.Text
  studyMinutes Int
  studiedAt    DateTime                @db.Date
  category     LearningCategory        @default(OTHER)
  userId       String                  @db.Uuid
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  technologies LearningLogTechnology[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([userId, studiedAt])
}

model Technology {
  id           String                  @id @default(uuid()) @db.Uuid
  name         String                  @unique
  projects     ProjectTechnology[]
  learningLogs LearningLogTechnology[]
  primaryUsers UserTechnology[]
  createdAt    DateTime                @default(now())
}

model UserTechnology {
  userId       String     @db.Uuid
  technologyId String     @db.Uuid
  position     Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@id([userId, technologyId])
  @@unique([userId, position])
  @@index([technologyId])
}

model ProjectTechnology {
  projectId    String     @db.Uuid
  technologyId String     @db.Uuid
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@id([projectId, technologyId])
  @@index([technologyId])
}

model LearningLogTechnology {
  learningLogId String      @db.Uuid
  technologyId  String      @db.Uuid
  learningLog   LearningLog @relation(fields: [learningLogId], references: [id], onDelete: Cascade)
  technology    Technology  @relation(fields: [technologyId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@id([learningLogId, technologyId])
  @@index([technologyId])
}

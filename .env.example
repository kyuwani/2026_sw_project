# PostgreSQL runtime connection string (pooled URL in Preview/Production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Migration and admin connection string (direct URL in Preview/Production)
# Local development may omit this and fall back to DATABASE_URL.
DIRECT_URL=""

# Required. Generate a unique value with: openssl rand -base64 32
AUTH_SECRET=""

# Optional GitHub OAuth App credentials
# Local callback URL: http://localhost:3000/api/auth/callback/github
# Preview and Production must use separate OAuth Apps and callback hosts.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
